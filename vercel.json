{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [],
  "rewrites": [
    { "source": "/", "destination": "/medique-home" },
    { "source": "/admin", "destination": "/JC_Admin" },
    { "source": "/super", "destination": "/super" },
    { "source": "/app", "destination": "/JC_App" },
    { "source": "/reservar", "destination": "/agendar" },
    { "source": "/movil", "destination": "/JC_Mobile" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' *.gstatic.com *.googleapis.com *.firebaseapp.com *.firebaseio.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' unpkg.com www.gstatic.com www.google.com cdn.jsdelivr.net cdnjs.cloudflare.com esm.sh; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: blob: *; frame-src 'self' www.google.com www.gstatic.com; connect-src 'self' *.googleapis.com *.firebaseio.com *.firebaseapp.com www.google.com api.groq.com api.rss2json.com cdn.jsdelivr.net; worker-src 'self' blob: cdn.jsdelivr.net; frame-ancestors 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/(JC_App|JC_Admin|JC_Mobile|agendar|index|super|review|colaborar|medique-home)(.html)?",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/dist/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(js|jsx|css|png|jpg|jpeg|webp|svg|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 13 * * *" }
  ]
}
